{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tribes",
  "account_id": "857baf33b60304062a4051fa7f04d88e",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // The site files at the repo root; .assetsignore keeps everything else out.
  // The Worker runs first so every response gets its headers.
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "tribes-wall", "database_id": "329f4601-449e-4cda-8094-27524ebb3e5e", "migrations_dir": "worker/migrations" }
  ],
  // Per-IP limit on wall posts (no IPs are stored).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "2701", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://tribes.thefai.org,https://fai-org.github.io",
    "ACCESS_TEAM_DOMAIN": "https://thefai.cloudflareaccess.com",
    // Audience tag of the "FAI Tribes Wall Admin" Access application (tribes.thefai.workers.dev/admin).
    "ACCESS_AUD": "5fd3ebaa715db5c89ef62b1965b5ea3d8236913fb2ffecbc47bb425334acfa2a",
    "ADMIN_EMAIL_DOMAIN": "thefai.org",
    // Keep search engines out until launch; set to "0" to allow indexing.
    "NOINDEX": "1"
  },
  "observability": { "enabled": true }
}
